HEADLESS=false
SLOW_MO_MS=150
GMAIL_URL=https://mail.google.com/mail/u/0/#inbox
DEFAULT_TIMEZONE=Asia/Jakarta
MIN_GAP_MINUTES=7
SCREENSHOT_DIR=./screenshots
LOGS_DIR=./logs
PROFILES_DIR=./profiles
DATA_DIR=./data

# Web dashboard server
PORT=5000
# REQUIRED before exposing the server to your team (tunnel/LAN).
# Every API request must send this token (set it once in the dashboard Settings page).
DASHBOARD_TOKEN=
