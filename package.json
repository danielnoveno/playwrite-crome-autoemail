{
  "name": "gmail-scheduler",
  "version": "1.0.0",
  "description": "Native Gmail Schedule Send using Playwright",
  "main": "src/scheduleNative.js",
  "scripts": {
    "login": "node src/loginProfiles.js",
    "schedule": "node src/scheduleNative.js",
    "test:dry": "node src/scheduleNative.js --limit=3 --dry-run",
    "test:small": "node src/scheduleNative.js --limit=3",
    "convert": "node scripts/excelToScheduleCsv.js --input=data/schedule_tracker.xlsx --output=data/schedule_tracker.csv --start-time=21:00 --gap-minutes=7",
    "validate": "node scripts/validateSchedule.js",
    "start": "node server.js",
    "desktop": "electron desktop/main.js",
    "desktop:build": "electron-builder --config desktop/electron-builder.yml"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "csv-parse": "^5.5.6",
    "csv-stringify": "^6.5.0",
    "dayjs": "^1.11.11",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "multer": "^2.1.1",
    "playwright": "^1.44.0",
    "xlsx": "^0.18.5",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.gmail-scheduler.desktop",
    "productName": "Gmail Scheduler",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "server.js",
      "server/**/*",
      "src/**/*",
      "scripts/**/*",
      "data/**/*",
      "dashboard/frontend/dist/**/*",
      "package.json",
      ".env"
    ],
    "extraResources": [
      { "from": "data", "to": "data" }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "desktop/icon.ico"
    }
  }
}
